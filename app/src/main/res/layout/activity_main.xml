<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#90EE90">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wizyta_u_weterynarza"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="#2E8B57"
        android:padding="10dp"
        android:gravity="center" />

    <EditText
        android:id="@+id/etOwner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/imi_i_nazwisko_w_a_ciciela"
        android:inputType="textPersonName"
        android:padding="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gatunek"
        android:textStyle="bold"
        android:paddingLeft="10dp"
        android:paddingTop="5dp" />

    <ListView
        android:id="@+id/listViewSpecies"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:choiceMode="singleChoice" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvAgeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ile_ma_lat_0"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekBarAge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="20"
            android:progress="0" />
    </LinearLayout>

    <EditText
        android:id="@+id/etPurpose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/cel_wizyty"
        android:inputType="text"
        android:padding="10dp" />

    <TimePicker
        android:id="@+id/timePickerVisit"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:timePickerMode="spinner" />

    <Button
        android:id="@+id/btnOk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ok"
        android:backgroundTint="#2E8B57"
        android:textColor="@android:color/white"
        android:layout_margin="10dp" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:textStyle="bold"
        android:textSize="16sp" />

</LinearLayout>